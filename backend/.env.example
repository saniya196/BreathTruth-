# ===== DATABASE =====
# Local MongoDB
MONGO_URI=your_mongodb_uri

# MongoDB Atlas (Cloud - recommended for production)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/breathtruth?retryWrites=true&w=majority

# ===== SERVER =====
PORT=5000
NODE_ENV=development

# CORS - Update for your frontend domain
CLIENT_URL=http://localhost:3000

# ===== AUTHENTICATION =====
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d

# ===== EMAIL ALERTS =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password

# ===== CPCB API (Official Government AQI Data) =====
CPCB_API_KEY=your_cpcb_api_key
CPCB_API_URL=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# ===== DEPLOYMENT NOTES =====
# When deploying:
# 1. For CLIENT_URL: Use your deployed frontend URL (e.g., https://breathtruth.vercel.app)
# 2. For MONGO_URI: Use MongoDB Atlas connection string
# 3. For JWT_SECRET: Generate a strong random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. For EMAIL credentials: Use Gmail App Password (not your regular Gmail password)
# 5. Set NODE_ENV=production for production deployment
