# Example environment variables for BreathTruth backend
# Copy this file to .env and fill in real values. Do NOT commit your real
# secrets into the repository. Keep `.env` listed in .gitignore.

# ===== DATABASE =====
# Example MongoDB connection string (replace placeholders)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/breathtruth?retryWrites=true&w=majority

# ===== SERVER =====
PORT=5000
NODE_ENV=development

# CORS - Update for your frontend domain
CLIENT_URL=http://localhost:3000

# ===== AUTHENTICATION =====
# Use a strong secret in your local .env (do not check in)
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRE=7d

# ===== EMAIL ALERTS =====
# If you use email alerts, provide SMTP credentials in your local .env
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# ===== WAQI API (Official AQI and nearest station lookup) =====
# Provide your WAQI token here. Use 'demo' for limited testing if needed.
WAQI_TOKEN=demo

